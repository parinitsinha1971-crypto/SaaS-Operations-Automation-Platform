# Start the SaaS Ops stack at boot on a Linux host.
#
#   sudo cp -r saas-ops-platform /opt/
#   sudo cp deploy/systemd/saas-ops.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now saas-ops
#   journalctl -u saas-ops -f
[Unit]
Description=SaaS Operations Automation Platform (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/saas-ops-platform
ExecStartPre=/opt/saas-ops-platform/scripts/init-env.sh
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecReload=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

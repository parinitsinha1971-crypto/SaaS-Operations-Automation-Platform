    {
      "id": 22,
      "type": "table",
      "title": "Recent incidents",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ops-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ops-postgres"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT opened_at AS \"opened (UTC)\", service, severity, title, status,\n  EXTRACT(EPOCH FROM (COALESCE(resolved_at, now() AT TIME ZONE 'utc') - opened_at))::int AS duration,\n  restarts\nFROM incidents\nWHERE $__timeFilter(opened_at)\nORDER BY opened_at DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {

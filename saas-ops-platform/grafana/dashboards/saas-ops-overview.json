{
  "uid": "saas-ops-overview",
  "title": "SaaS Ops Overview",
  "tags": [
    "saas-ops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ops_service_up, service)",
          "refId": "service"
        },
        "definition": "label_values(ops_service_up, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      }
    ]
  },
  "links": [
    {
      "title": "Ops console",
      "url": "http://localhost:8080",
      "type": "link",
      "targetBlank": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Restarts",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ops-postgres"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "rawSql": "SELECT started_at AS time, service || ' restarted (' || reason || ')' AS text FROM remediation_actions WHERE status = 'success' AND $__timeFilter(started_at)",
          "format": "table",
          "refId": "Anno"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Service state",
      "description": "Debounced state from the ops platform's checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (ops_service_state{state=\"degraded\",service=~\"$service\"}) + 2 * sum by (service) (ops_service_state{state=\"down\",service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "degraded",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "down",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
